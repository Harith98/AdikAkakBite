# Copy this file to .env.local and fill in your own Supabase project values.
# Never commit .env.local — it is already covered by .gitignore.

# Found in Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively in server-side API routes/actions that need
# to bypass RLS for trusted system operations (e.g. scheduled jobs). Never
# expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `npm run db:types` to generate TypeScript types from your schema.
SUPABASE_PROJECT_ID=

# App defaults (used as fallbacks if a business hasn't set these yet)
NEXT_PUBLIC_DEFAULT_CURRENCY=MYR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# There is intentionally no AI API key in V1.
# See docs/ai-readiness.md before adding one in a future version.

# Public address used in invite links and Supabase email redirects.
# Optional: defaults to https://adik-akak-bite.vercel.app in production builds
# (previews included) and to the current address in local dev. Set it if you
# move to a custom domain. Must also be allowed in Supabase → Authentication →
# URL Configuration.
NEXT_PUBLIC_SITE_URL=
